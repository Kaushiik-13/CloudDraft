{
  "name": "clouddraft",
  "version": "0.5.2",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "biome check .",
    "lint:fix": "biome check --apply-unsafe .",
    "depcruise": "depcruise packages/*/src --config .dependency-cruiser.cjs",
    "lint:templates": "pnpm --filter @eraserlabs/diagram-templates exec vitest run test/lint.test.ts",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "test:e2e": "pnpm --filter @eraserlabs/render test:e2e && pnpm --filter @eraserlabs/diagrams test:e2e",
    "snap": "pnpm --filter @eraserlabs/diagrams snap",
    "snap:update": "pnpm --filter @eraserlabs/diagrams snap:update",
    "snap:report": "pnpm --filter @eraserlabs/diagrams snap:report",
    "architecture": "node packages/diagrams/architecture.mjs",
    "icons:cloud": "node tools/install-cloud-icons.mjs",
    "mcp:build": "node tools/mcp/build.mjs",
    "mcp": "node tools/mcp/server.mjs",
    "mcp:http": "node tools/mcp/server.mjs --http",
    "canvas": "node tools/mcp/server.mjs --preview"
  },
  "devDependencies": {
    "@biomejs/biome": "1.8.3",
    "@eraserlabs/diagrams": "workspace:*",
    "@eraserlabs/resolve": "workspace:*",
    "@types/node": "^22.10.0",
    "dependency-cruiser": "^16.10.0",
    "esbuild": "0.25.12",
    "prettier": "^3.4.2",
    "tsx": "^4.23.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "^4.6.7"
  }
}
